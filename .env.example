# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución (development / test / production)
NODE_ENV=development

# Clave secreta para firma y cifrado de sesiones (cambiar en producción)
SESSION_SECRET=reemplazar_con_un_secreto_aleatorio_y_seguro

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/gastos.db

# Límite máximo en pesos para gastos deducibles en efectivo (Art. 27 LISR)
LIMITE_EFECTIVO_DEDUCIBLE=2000.00

# Forzar flag Secure en cookies de sesión (activar solo si el sitio se sirve bajo HTTPS)
COOKIE_SECURE=false
